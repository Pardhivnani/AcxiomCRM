## =======================================================
## Standard .gitignore for .NET / C# / ASP.NET Core Project
## =======================================================

# Build and compilation results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.ide/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# Test and Code Coverage results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage.cobertura.xml
*.coverage
*.coveragexml

# SQLite and Local Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# Environment, secrets, and sensitive settings
secrets.json
appsettings.Production.json
appsettings.*.local.json

# Scratch and environment home dirs
.dotnet_home/
.nuget_packages/
.appdata/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# OS generated files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes
