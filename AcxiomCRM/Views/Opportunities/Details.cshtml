@model AcxiomCRM.Models.Entities.Opportunity
@using AcxiomCRM.Models.Enums
@{
    ViewData["Title"] = $"Opportunity - {Model.OpportunityName}";
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-arrow-left"></i></a>
            <h3 class="fw-bold text-dark mb-0">@Model.OpportunityName</h3>
            <span class="badge bg-primary">@Model.Status</span>
        </div>
        <p class="text-secondary small mb-0">Pipeline Deal Overview & Stage Tracking</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Add Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-task me-1"></i> Log Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
    </div>
</div>

<!-- Interactive Stage Progression Stepper -->
<div class="crm-card mb-4">
    <div class="crm-card-header">
        <span class="crm-card-title"><i class="bi bi-diagram-3 me-2 text-primary"></i>Deal Stage Progression</span>
    </div>
    <div class="crm-card-body p-3">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @foreach (OpportunityStage stage in Enum.GetValues<OpportunityStage>())
            {
                var isCurrent = Model.Stage == stage;
                var btnClass = isCurrent
                    ? (stage == OpportunityStage.Won ? "btn-success" : (stage == OpportunityStage.Lost ? "btn-danger" : "btn-primary"))
                    : "btn-outline-secondary";

                <form asp-action="UpdateStage" asp-route-id="@Model.OpportunityId" asp-route-newStage="@stage" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm @btnClass d-flex align-items-center gap-1">
                        @if (isCurrent)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                        }
                        <span>@stage</span>
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Left Column: Deal Metrics -->
    <div class="col-lg-4">
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-currency-dollar me-2 text-success"></i>Financials & Info</span>
            </div>
            <div class="crm-card-body p-3">
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Customer Account</label>
                    <div class="fw-bold">
                        @if (Model.Customer != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="text-decoration-none">
                                @Model.Customer.CustomerName
                            </a>
                        }
                    </div>
                </div>

                @if (Model.Lead != null)
                {
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">Converted From Lead</label>
                        <div>
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.Lead.LeadId" class="text-decoration-none">
                                @Model.Lead.LeadName (@Model.Lead.LeadCode)
                            </a>
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Deal Amount</label>
                    <div class="h4 fw-bold text-dark mb-0">$@Model.Amount.ToString("N0")</div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Closing Probability</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @Model.Probability%;"></div>
                        </div>
                        <span class="fw-bold">@Model.Probability%</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Weighted Pipeline Forecast</label>
                    <div class="h5 fw-bold text-primary mb-0">$@Model.WeightedPipeline.ToString("N0")</div>
                    <small class="text-muted">Calculated as Amount × @Model.Probability%</small>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Expected Close Date</label>
                    <div class="fw-semibold">@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Deal Owner</label>
                    <div class="fw-semibold">@(Model.AssignedTo?.FullName ?? "Unassigned")</div>
                </div>

                <div class="border-top pt-2">
                    <label class="text-muted small fw-semibold">Notes & Description</label>
                    <p class="small text-secondary mb-0">@(Model.Notes ?? "No additional notes recorded.")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Associated Records -->
    <div class="col-lg-8">
        <!-- Related Follow-Ups -->
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-calendar-check me-2 text-amber"></i>Scheduled Follow-Ups (@Model.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-sm btn-link text-decoration-none">Add Follow-Up</a>
            </div>
            <div class="table-responsive">
                <table class="crm-table table mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td><small>@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                    <td><span class="badge bg-warning text-dark">@f.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No follow-ups recorded for this deal.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Related Activities -->
        <div class="crm-card">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-list-task me-2 text-purple"></i>Activities History (@Model.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-sm btn-link text-decoration-none">Log Activity</a>
            </div>
            <div class="crm-card-body p-3">
                @if (Model.Activities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in Model.Activities)
                        {
                            <li class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>@a.Subject</strong>
                                    <small class="text-muted">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</small>
                                </div>
                                <div class="small text-secondary">@(a.Description ?? "No description.")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center text-muted py-3">No activities logged for this deal.</div>
                }
            </div>
        </div>
    </div>
</div>

