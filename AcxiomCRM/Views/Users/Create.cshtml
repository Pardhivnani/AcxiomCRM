@model AcxiomCRM.ViewModels.Users.UserCreateViewModel
@{
    ViewData["Title"] = "Create User";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold text-dark mb-0">Create User Account</h4>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-person-plus me-2 text-primary"></i>User Account Details</span>
            </div>
            <div class="crm-card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" placeholder="user@acxiomcrm.local" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <select asp-for="Role" class="form-select" asp-items="ViewBag.RolesList">
                                <option value="">-- Assign Role --</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold small">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Enterprise Sales" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ManagerId" class="form-label fw-semibold small">Reports to Manager</label>
                            <select asp-for="ManagerId" class="form-select" asp-items="ViewBag.ManagersList">
                                <option value="">-- No Direct Manager --</option>
                            </select>
                            <span asp-validation-for="ManagerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check mt-3">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold small">Account is Active</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

