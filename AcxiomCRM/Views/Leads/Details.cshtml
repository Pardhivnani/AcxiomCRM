@model AcxiomCRM.Models.Entities.Lead
@using AcxiomCRM.Models.Enums
@{
    ViewData["Title"] = $"Lead - {Model.LeadName}";
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-arrow-left"></i></a>
            <h3 class="fw-bold text-dark mb-0">@Model.LeadName</h3>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            <span class="badge bg-primary">@Model.Status</span>
        </div>
        <p class="text-secondary small mb-0">Lead Profile, Qualification & Conversion Workspace</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        @if (Model.Status != LeadStatus.Converted)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-arrow-repeat"></i> Convert to Customer
            </a>
        }
        else if (Model.CustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId.Value" class="btn btn-outline-success btn-sm">
                <i class="bi bi-person-check me-1"></i> View Converted Customer
            </a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Lead
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Left Column: Lead Info -->
    <div class="col-lg-4">
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Lead Summary</span>
            </div>
            <div class="crm-card-body p-3">
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Company / Organization</label>
                    <div class="fw-bold">@(Model.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Email Address</label>
                    <div><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Phone Number</label>
                    <div><a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Lead Source</label>
                    <div><span class="badge bg-light text-dark border">@Model.Source</span></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Priority</label>
                    <div>
                        <span class="badge @(Model.Priority == LeadPriority.High ? "bg-danger" : (Model.Priority == LeadPriority.Medium ? "bg-warning text-dark" : "bg-secondary"))">
                            @Model.Priority Priority
                        </span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Expected Deal Value</label>
                    <div class="h5 fw-bold text-primary mb-0">$@Model.ExpectedValue.ToString("N0")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Assigned Executive</label>
                    <div class="fw-semibold">@(Model.AssignedTo?.FullName ?? "Unassigned")</div>
                </div>
                <div class="border-top pt-2">
                    <label class="text-muted small fw-semibold">Notes / Context</label>
                    <p class="small text-secondary mb-0">@(Model.Notes ?? "No initial notes recorded.")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Associated Records -->
    <div class="col-lg-8">
        <!-- Related Opportunities -->
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-briefcase me-2 text-primary"></i>Opportunities Originating from this Lead (@Model.Opportunities.Count)</span>
            </div>
            <div class="table-responsive">
                <table class="crm-table table mb-0">
                    <thead>
                        <tr>
                            <th>Opportunity</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Close Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Opportunities.Any())
                        {
                            foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-dark text-decoration-none">
                                            @opp.OpportunityName
                                        </a>
                                    </td>
                                    <td class="fw-bold">$@opp.Amount.ToString("N0")</td>
                                    <td><span class="badge bg-light text-dark border">@opp.Stage</span></td>
                                    <td><small class="text-muted">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</small></td>
                                    <td><span class="badge bg-primary">@opp.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No opportunities linked to this lead yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Related Follow-Ups -->
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-calendar-check me-2 text-amber"></i>Follow-Ups (@Model.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">Add Follow-Up</a>
            </div>
            <div class="table-responsive">
                <table class="crm-table table mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td><small>@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                    <td><span class="badge bg-warning text-dark">@f.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No follow-ups recorded for this lead.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Related Activities -->
        <div class="crm-card">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-list-task me-2 text-purple"></i>Activity History (@Model.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">Log Activity</a>
            </div>
            <div class="crm-card-body p-3">
                @if (Model.Activities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in Model.Activities)
                        {
                            <li class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>@a.Subject</strong>
                                    <small class="text-muted">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</small>
                                </div>
                                <div class="small text-secondary">@(a.Description ?? "No description.")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center text-muted py-3">No activities logged for this lead.</div>
                }
            </div>
        </div>
    </div>
</div>

