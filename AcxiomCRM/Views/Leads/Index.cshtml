@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.Lead>
@using AcxiomCRM.Models.Enums
@{
    ViewData["Title"] = "Lead Management";
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Lead Management</h3>
        <p class="text-secondary small mb-0">Capture, nurture, qualify, and convert sales prospects.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-funnel-fill"></i> Add New Lead
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="filter-card">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-secondary">Search Leads</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" class="form-control" placeholder="Name, Code, Email, Company..." value="@ViewBag.SearchTerm" />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary">Status</label>
            <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<LeadStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary">Priority</label>
            <select name="priority" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<LeadPriority>()">
                <option value="">All Priorities</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-secondary">Assigned Executive</label>
            <select name="assignedToUserId" class="form-select form-select-sm" asp-items="ViewBag.SalesExecutives">
                <option value="">All Executives</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="crm-table table mb-0">
            <thead>
                <tr>
                    <th>Lead Code</th>
                    <th>Lead Name</th>
                    <th>Contact Info</th>
                    <th>Company & Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected ($)</th>
                    <th>Assigned</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var l in Model.Items)
                    {
                        var statusClass = l.Status switch
                        {
                            LeadStatus.New => "badge-active",
                            LeadStatus.Contacted => "badge-contacted",
                            LeadStatus.Qualified => "badge-qualified",
                            LeadStatus.Converted => "badge-converted",
                            LeadStatus.Lost => "badge-lost",
                            _ => "badge-inactive"
                        };

                        var priorityColor = l.Priority switch
                        {
                            LeadPriority.High => "text-danger fw-bold",
                            LeadPriority.Medium => "text-warning fw-semibold",
                            _ => "text-muted"
                        };

                        <tr>
                            <td><span class="badge bg-light text-dark border fw-bold">@l.LeadCode</span></td>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="text-decoration-none text-dark">
                                    @l.LeadName
                                </a>
                            </td>
                            <td>
                                <div><small class="text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@l.Email</small></div>
                                <div><small class="text-muted"><i class="bi bi-telephone me-1 text-muted"></i>@l.Phone</small></div>
                            </td>
                            <td>
                                <div>@(l.CompanyName ?? "-")</div>
                                <span class="badge bg-light text-secondary border" style="font-size: 0.72rem;">@l.Source</span>
                            </td>
                            <td>
                                <span class="badge-status @statusClass">
                                    <span class="badge-status-dot"></span>
                                    @l.Status
                                </span>
                            </td>
                            <td><span class="@priorityColor">@l.Priority</span></td>
                            <td class="fw-bold text-primary">$@l.ExpectedValue.ToString("N0")</td>
                            <td><small class="fw-semibold">@(l.AssignedTo?.FullName ?? "Unassigned")</small></td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border py-0 px-2" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item py-1" asp-action="Details" asp-route-id="@l.LeadId">
                                                <i class="bi bi-eye text-primary me-2"></i> View Details
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-1" asp-action="Edit" asp-route-id="@l.LeadId">
                                                <i class="bi bi-pencil text-warning me-2"></i> Edit
                                            </a>
                                        </li>
                                        @if (l.Status != LeadStatus.Converted)
                                        {
                                            <li>
                                                <a class="dropdown-item py-1 text-success fw-semibold" asp-action="Convert" asp-route-id="@l.LeadId">
                                                    <i class="bi bi-arrow-repeat me-2"></i> Convert to Customer
                                                </a>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item py-1 text-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteConfirmModal"
                                                    data-record-name="@l.LeadName (@l.LeadCode)"
                                                    data-delete-url="@Url.Action("Delete", "Leads", new { id = l.LeadId })">
                                                <i class="bi bi-trash me-2"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <i class="bi bi-funnel fs-2 d-block mb-2 text-secondary"></i>
                            No leads found matching the filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="px-3 pb-3">
        <partial name="_Pagination" model="Model" />
    </div>
</div>

