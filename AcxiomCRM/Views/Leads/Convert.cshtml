@model AcxiomCRM.ViewModels.Lead.LeadConvertViewModel
@{
    ViewData["Title"] = $"Convert Lead - {Model.LeadName}";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold text-dark mb-0">Lead Conversion Workflow</h4>
        </div>

        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-arrow-repeat fs-3 text-primary"></i>
            <div>
                <strong>Convert Lead to Active Customer Account</strong>
                <p class="mb-0 small text-secondary">
                    Converting this lead will automatically create a new customer record, mark this lead as <strong>Converted</strong>, and optionally create an active deal opportunity in your sales pipeline.
                </p>
            </div>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-check-circle me-2 text-success"></i>Conversion Configuration</span>
            </div>
            <div class="crm-card-body p-4">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- Step 1: Customer Account Details Preview -->
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <span class="badge bg-primary rounded-circle me-1">1</span> Customer Account Information
                    </h6>
                    <div class="row g-2 mb-4 bg-light p-3 rounded">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Customer / Company Name:</small>
                            <strong class="text-dark">@(!string.IsNullOrWhiteSpace(Model.CompanyName) ? Model.CompanyName : Model.LeadName)</strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Contact Name:</small>
                            <strong>@Model.LeadName</strong>
                        </div>
                        <div class="col-md-6 mt-2">
                            <small class="text-muted d-block">Email Address:</small>
                            <span>@Model.Email</span>
                        </div>
                        <div class="col-md-6 mt-2">
                            <small class="text-muted d-block">Phone Number:</small>
                            <span>@Model.Phone</span>
                        </div>
                    </div>

                    <!-- Step 2: Opportunity Deal Options -->
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <span class="badge bg-primary rounded-circle me-1">2</span> Deal Opportunity Options
                    </h6>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" id="toggleOpportunitySwitch" />
                        <label asp-for="CreateOpportunity" class="form-check-label fw-semibold">
                            Create a deal opportunity in the pipeline upon conversion
                        </label>
                    </div>

                    <div id="opportunityFieldsContainer" class="p-3 border rounded bg-light-subtle mb-3">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="OpportunityName" class="form-label fw-semibold small"></label>
                                <input asp-for="OpportunityName" class="form-control" />
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OpportunityAmount" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="OpportunityAmount" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small"></label>
                                <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 py-2 fw-semibold">
                            <i class="bi bi-arrow-repeat me-1"></i> Complete Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const toggleSwitch = document.getElementById('toggleOpportunitySwitch');
        const container = document.getElementById('opportunityFieldsContainer');

        function updateFields() {
            if (toggleSwitch && container) {
                container.style.display = toggleSwitch.checked ? 'block' : 'none';
            }
        }

        if (toggleSwitch) {
            toggleSwitch.addEventListener('change', updateFields);
            updateFields();
        }
    </script>
}

