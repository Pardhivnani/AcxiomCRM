@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.FollowUp>
@using AcxiomCRM.Models.Enums
@{
    ViewData["Title"] = "Follow-Up Management";
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Follow-Up Engagements</h3>
        <p class="text-secondary small mb-0">Schedule and execute client follow-ups, calls, and product demos.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-calendar-plus-fill"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="filter-card">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-secondary">Search</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" class="form-control" placeholder="Subject, Customer..." value="@ViewBag.SearchTerm" />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary">Status</label>
            <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FollowUpStatus>()">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary">Type</label>
            <select name="type" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FollowUpType>()">
                <option value="">All Types</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary">Start Date</label>
            <input type="date" name="startDate" class="form-control form-control-sm" value="@ViewBag.StartDate" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="crm-table table mb-0">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Associated With</th>
                    <th>Scheduled Date</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var f in Model.Items)
                    {
                        var statusBadge = f.Status switch
                        {
                            FollowUpStatus.Completed => "badge-active",
                            FollowUpStatus.Missed => "badge-lost",
                            FollowUpStatus.Planned => "badge-qualified",
                            _ => "badge-inactive"
                        };

                        <tr>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@f.FollowUpId" class="text-decoration-none text-dark hover-primary">
                                    @f.Subject
                                </a>
                                @if (!string.IsNullOrWhiteSpace(f.Remarks))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 280px;">@f.Remarks</div>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none">
                                        <i class="bi bi-building me-1"></i>@f.Customer.CustomerName
                                    </a>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none">
                                        <i class="bi bi-person me-1"></i>@f.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold @(f.Status == FollowUpStatus.Planned && f.FollowUpDate.Date < DateTime.UtcNow.Date ? "text-danger" : "text-dark")">
                                    @f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")
                                </div>
                            </td>
                            <td>
                                <span class="badge-status @statusBadge">
                                    <span class="badge-status-dot"></span>
                                    @f.Status
                                </span>
                            </td>
                            <td><small class="fw-semibold">@(f.AssignedTo?.FullName ?? "-")</small></td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    @if (f.Status == FollowUpStatus.Planned)
                                    {
                                        <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Completed">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Reschedule" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-secondary" title="Reschedule Date">
                                            <i class="bi bi-calendar-event"></i>
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteConfirmModal"
                                            data-record-name="@f.Subject"
                                            data-delete-url="@Url.Action("Delete", "FollowUps", new { id = f.FollowUpId })">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary"></i>
                            No follow-ups found matching the specified filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="px-3 pb-3">
        <partial name="_Pagination" model="Model" />
    </div>
</div>

