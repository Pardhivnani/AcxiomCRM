@model AcxiomCRM.Models.Entities.FollowUp
@using AcxiomCRM.Models.Enums
@{
    ViewData["Title"] = $"Follow-Up: {Model.Subject}";
    Layout = "_Layout";

    var statusBadge = Model.Status switch
    {
        FollowUpStatus.Completed => "badge-active",
        FollowUpStatus.Missed => "badge-lost",
        FollowUpStatus.Planned => "badge-qualified",
        _ => "badge-inactive"
    };

    var typeIcon = Model.FollowUpType switch
    {
        FollowUpType.Call => "bi-telephone-fill text-success",
        FollowUpType.Meeting => "bi-people-fill text-primary",
        FollowUpType.Email => "bi-envelope-fill text-info",
        FollowUpType.Demo => "bi-laptop-fill text-purple",
        _ => "bi-calendar-check-fill text-warning"
    };
}

<!-- Breadcrumbs & Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Follow-Ups</a></li>
                <li class="breadcrumb-item active" aria-current="page">Follow-Up #@Model.FollowUpId</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <h3 class="fw-bold text-dark mb-0">@Model.Subject</h3>
            <span class="badge-status @statusBadge">
                <span class="badge-status-dot"></span>
                @Model.Status
            </span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        @if (Model.Status == FollowUpStatus.Planned)
        {
            <form asp-action="Complete" asp-route-id="@Model.FollowUpId" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-sm d-flex align-items-center gap-1">
                    <i class="bi bi-check-circle-fill"></i> Mark Completed
                </button>
            </form>
            <a asp-action="Reschedule" asp-route-id="@Model.FollowUpId" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-calendar-event"></i> Reschedule
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Main Info Card -->
    <div class="col-lg-8">
        <div class="crm-card mb-4">
            <div class="crm-card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-calendar3 me-2 text-primary"></i>Follow-Up Details</h6>
                <span class="badge bg-light text-dark border">
                    <i class="bi @typeIcon me-1"></i> @Model.FollowUpType
                </span>
            </div>
            <div class="crm-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-secondary small fw-semibold">Scheduled Date & Time</label>
                        <div class="fw-bold fs-6 @(Model.Status == FollowUpStatus.Planned && Model.FollowUpDate.Date < DateTime.UtcNow.Date ? "text-danger" : "text-dark")">
                            <i class="bi bi-clock me-1 text-muted"></i> @Model.FollowUpDate.ToString("f")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-secondary small fw-semibold">Status</label>
                        <div>
                            <span class="badge-status @statusBadge">
                                <span class="badge-status-dot"></span>
                                @Model.Status
                            </span>
                        </div>
                    </div>

                    @if (Model.CompletedDate.HasValue)
                    {
                        <div class="col-sm-6">
                            <label class="text-secondary small fw-semibold">Completed Timestamp</label>
                            <div class="text-success fw-semibold">
                                <i class="bi bi-check2-all me-1"></i> @Model.CompletedDate.Value.ToString("f")
                            </div>
                        </div>
                    }

                    <div class="col-12">
                        <label class="text-secondary small fw-semibold">Remarks & Notes</label>
                        <div class="p-3 bg-light rounded text-dark border" style="white-space: pre-wrap; font-size: 0.9rem;">
                            @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks or notes recorded." : Model.Remarks)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Associated Entities & Ownership -->
    <div class="col-lg-4">
        <!-- Related Entity Card -->
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-link-45deg me-2 text-primary"></i>Associated Context</h6>
            </div>
            <div class="crm-card-body p-0">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted"><i class="bi bi-building me-1"></i> Customer:</span>
                        @if (Model.Customer != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-decoration-none">
                                @Model.Customer.CustomerName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted"><i class="bi bi-funnel me-1"></i> Lead:</span>
                        @if (Model.Lead != null)
                        {
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="fw-bold text-decoration-none">
                                @Model.Lead.LeadName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted"><i class="bi bi-briefcase me-1"></i> Opportunity:</span>
                        @if (Model.Opportunity != null)
                        {
                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId" class="fw-bold text-decoration-none">
                                @Model.Opportunity.OpportunityName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </li>
                </ul>
            </div>
        </div>

        <!-- Assignment Card -->
        <div class="crm-card">
            <div class="crm-card-header">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-badge me-2 text-primary"></i>Ownership</h6>
            </div>
            <div class="crm-card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="user-avatar bg-primary text-white">
                        @(Model.AssignedTo?.FullName?.FirstOrDefault() ?? 'U')
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@(Model.AssignedTo?.FullName ?? "Unassigned")</div>
                        <div class="text-muted small">@(Model.AssignedTo?.Email ?? "-")</div>
                    </div>
                </div>
                <hr class="my-3">
                <div class="d-flex justify-content-between text-muted small">
                    <span>Created:</span>
                    <span>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        </div>
    </div>
</div>

