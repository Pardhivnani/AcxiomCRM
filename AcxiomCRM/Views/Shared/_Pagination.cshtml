@model dynamic
@{
    int pageNumber = Model.Page;
    int totalPages = Model.TotalPages;
    int totalCount = Model.TotalCount;
    int pageSize = Model.PageSize;
}

@if (totalCount > 0)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top text-muted" style="font-size: 0.88rem;">
        <div>
            Showing <strong>@(((pageNumber - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(pageNumber * pageSize, totalCount))</strong> of <strong>@totalCount</strong> records
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-2 mt-md-0">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@BuildPageUrl(pageNumber - 1)" aria-label="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = Math.Max(1, pageNumber - 2); i <= Math.Min(totalPages, pageNumber + 2); i++)
                    {
                        <li class="page-item @(i == pageNumber ? "active" : "")">
                            <a class="page-link" href="@BuildPageUrl(i)">@i</a>
                        </li>
                    }

                    <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@BuildPageUrl(pageNumber + 1)" aria-label="Next">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@functions {
    private string BuildPageUrl(int targetPage)
    {
        var queryParams = new Dictionary<string, string?>();
        foreach (var key in ViewContext.HttpContext.Request.Query.Keys)
        {
            if (!string.IsNullOrEmpty(key) && key != "page")
            {
                queryParams[key] = ViewContext.HttpContext.Request.Query[key].ToString();
            }
        }
        queryParams["page"] = targetPage.ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(ViewContext.HttpContext.Request.Path, queryParams);
    }
}
