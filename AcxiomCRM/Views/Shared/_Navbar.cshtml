@using AcxiomCRM.Models.Enums
<header class="crm-topbar">
    <div class="d-flex align-items-center gap-3">
        <button class="toggle-sidebar-btn" id="sidebarToggleBtn" type="button" title="Toggle Sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>

        <span class="text-secondary fw-semibold d-none d-md-inline" style="font-size: 0.88rem;">
            Enterprise CRM Portal
        </span>
    </div>

    <div class="d-flex align-items-center gap-3">
        <a href="/swagger" target="_blank" class="btn btn-outline-primary btn-sm d-none d-sm-inline-flex align-items-center gap-1">
            <i class="bi bi-code-square"></i>
            <span>Swagger API</span>
        </a>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var roleBadgeClass = "role-sales";
            var roleDisplayName = "Sales Executive";
            if (User.IsInRole(UserRoles.Admin))
            {
                roleBadgeClass = "role-admin";
                roleDisplayName = "Administrator";
            }
            else if (User.IsInRole(UserRoles.Manager))
            {
                roleBadgeClass = "role-manager";
                roleDisplayName = "Manager";
            }

            var initial = !string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name[0].ToString().ToUpper() : "U";

            <div class="dropdown">
                <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">@initial</div>
                    <div class="d-none d-md-block text-start" style="line-height: 1.2;">
                        <div class="fw-bold text-dark" style="font-size: 0.88rem;">@User.Identity.Name</div>
                        <span class="role-pill @roleBadgeClass">@roleDisplayName</span>
                    </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenuDropdown" style="min-width: 220px; border-radius: 10px;">
                    <li class="px-3 py-2 border-bottom">
                        <div class="fw-bold" style="font-size: 0.88rem;">@User.Identity.Name</div>
                        <span class="role-pill @roleBadgeClass">@roleDisplayName</span>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="ChangePassword">
                            <i class="bi bi-key text-muted"></i>
                            <span>Change Password</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/swagger" target="_blank">
                            <i class="bi bi-terminal text-muted"></i>
                            <span>API Documentation</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger rounded py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Sign Out</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3">Sign In</a>
        }
    </div>
</header>

