@model AcxiomCRM.ViewModels.Customer.CustomerDetailsViewModel
@using AcxiomCRM.Models.Enums
@{
    var c = Model.Customer;
    ViewData["Title"] = $"Customer - {c.CustomerName}";
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-arrow-left"></i></a>
            <h3 class="fw-bold text-dark mb-0">@c.CustomerName</h3>
            <span class="badge bg-light text-dark border">@c.CustomerCode</span>
            <span class="badge-status @(c.Status == CustomerStatus.Active ? "badge-active" : "badge-inactive")">
                <span class="badge-status-dot"></span> @c.Status
            </span>
        </div>
        <p class="text-secondary small mb-0">Customer Profile & Related History</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> New Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Left Column: Customer Info & Stats -->
    <div class="col-lg-4">
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-info-circle me-2 text-primary"></i>Customer Information</span>
            </div>
            <div class="crm-card-body p-3">
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Company Name</label>
                    <div class="fw-bold">@(c.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Email Address</label>
                    <div><a href="mailto:@c.Email" class="text-decoration-none">@c.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Phone Number</label>
                    <div><a href="tel:@c.Phone" class="text-decoration-none">@c.Phone</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Office Address</label>
                    <div>@(c.Address ?? "-"), @(c.City ?? "-"), @(c.State ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Assigned Sales Executive</label>
                    <div class="fw-semibold">@(c.AssignedTo?.FullName ?? "Unassigned")</div>
                </div>
                <div class="border-top pt-2">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Created:</span>
                        <span>@c.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    @if (c.CreatedBy != null)
                    {
                        <div class="d-flex justify-content-between small text-muted mt-1">
                            <span>Created By:</span>
                            <span>@c.CreatedBy.FullName</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Portfolio Card -->
        <div class="metric-card mb-3">
            <div>
                <div class="metric-label">Total Deal Portfolio</div>
                <div class="metric-value text-primary">$@Model.TotalOpportunityValue.ToString("N0")</div>
                <div class="metric-sub">@Model.ActiveDealsCount Active Opportunities</div>
            </div>
            <div class="metric-icon-box icon-teal">
                <i class="bi bi-wallet2"></i>
            </div>
        </div>
    </div>

    <!-- Right Column: Related CRM Records -->
    <div class="col-lg-8">
        <!-- Related Opportunities -->
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-briefcase me-2 text-primary"></i>Opportunities (@c.Opportunities.Count)</span>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-link text-decoration-none">Add Opportunity</a>
            </div>
            <div class="table-responsive">
                <table class="crm-table table mb-0">
                    <thead>
                        <tr>
                            <th>Opportunity</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Close Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (c.Opportunities.Any())
                        {
                            foreach (var opp in c.Opportunities)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-dark text-decoration-none">
                                            @opp.OpportunityName
                                        </a>
                                    </td>
                                    <td class="fw-bold">$@opp.Amount.ToString("N0")</td>
                                    <td><span class="badge bg-light text-dark border">@opp.Stage</span></td>
                                    <td><small class="text-muted">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</small></td>
                                    <td>
                                        <span class="badge @(opp.Status == OpportunityStatus.Won ? "bg-success" : (opp.Status == OpportunityStatus.Lost ? "bg-danger" : "bg-primary"))">
                                            @opp.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No opportunities logged for this customer.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Related Follow-Ups -->
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-calendar-check me-2 text-amber"></i>Follow-Ups (@c.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-link text-decoration-none">Schedule Follow-Up</a>
            </div>
            <div class="table-responsive">
                <table class="crm-table table mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Assigned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (c.FollowUps.Any())
                        {
                            foreach (var f in c.FollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td><small>@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                    <td>
                                        <span class="badge @(f.Status == FollowUpStatus.Completed ? "bg-success" : (f.Status == FollowUpStatus.Missed ? "bg-danger" : "bg-warning text-dark"))">
                                            @f.Status
                                        </span>
                                    </td>
                                    <td><small>@(f.AssignedTo?.FullName ?? "-")</small></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No follow-ups recorded.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Related Activities -->
        <div class="crm-card">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-list-task me-2 text-purple"></i>Activities History (@c.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-link text-decoration-none">Log Activity</a>
            </div>
            <div class="crm-card-body p-3">
                @if (c.Activities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in c.Activities)
                        {
                            <li class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>@a.Subject</strong>
                                    <small class="text-muted">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</small>
                                </div>
                                <div class="small text-secondary">@(a.Description ?? "No description.")</div>
                                <small class="text-muted">Type: <strong>@a.ActivityType</strong> • Logged by: <strong>@(a.AssignedTo?.FullName ?? "User")</strong></small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center text-muted py-3">No activities recorded for this customer.</div>
                }
            </div>
        </div>
    </div>
</div>

