@model AcxiomCRM.ViewModels.Activity.ActivityCreateEditViewModel
@using AcxiomCRM.Models.Enums
@{
    ViewData["Title"] = $"Edit Activity - {Model.Subject}";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-arrow-left"></i></a>
            <h4 class="fw-bold text-dark mb-0">Edit Activity</h4>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <span class="crm-card-title"><i class="bi bi-pencil-square me-2 text-warning"></i>Modify Activity</span>
            </div>
            <div class="crm-card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ActivityId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label fw-semibold small"></label>
                            <select asp-for="ActivityType" class="form-select" asp-items="Html.GetEnumSelectList<ActivityType>()"></select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold small"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ActivityStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="ActivityDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedToUserId" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <select asp-for="AssignedToUserId" class="form-select" asp-items="Model.UsersList">
                                <option value="">-- Select Assigned Executive --</option>
                            </select>
                            <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CustomerId" class="form-label fw-semibold small"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="Model.CustomersList">
                                <option value="">-- Customer (Optional) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LeadId" class="form-label fw-semibold small"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="Model.LeadsList">
                                <option value="">-- Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="OpportunityId" class="form-label fw-semibold small"></label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="Model.OpportunitiesList">
                                <option value="">-- Opportunity (Optional) --</option>
                            </select>
                            <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold small">Detailed Description / Notes</label>
                            <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Update Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

