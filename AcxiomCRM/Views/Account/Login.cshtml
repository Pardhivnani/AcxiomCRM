@model AcxiomCRM.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-3 text-white mb-2" style="width: 52px; height: 52px; background: linear-gradient(135deg, #2563eb, #1e40af); font-size: 1.6rem; font-weight: 800;">
                A
            </div>
            <h3 class="fw-bold text-dark mb-1">AcxiomCRM</h3>
            <p class="text-secondary" style="font-size: 0.9rem;">Sign in to your enterprise CRM workspace</p>
        </div>

        <div class="crm-card shadow-sm border-0">
            <div class="crm-card-body p-4">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold" style="font-size: 0.88rem;">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" id="loginEmail" placeholder="name@company.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label fw-semibold mb-0" style="font-size: 0.88rem;">Password</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control border-start-0" id="loginPassword" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-secondary small">Remember me on this device</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>
                </form>

                <div class="mt-4 pt-3 border-top text-center">
                    <p class="text-muted small mb-0">
                        Don't have an account? <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Register here</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Development Seed Credentials Quick-fill Card -->
        <div class="card border border-primary-subtle bg-light shadow-sm mt-3">
            <div class="card-body p-3">
                <div class="fw-bold text-dark small mb-2 d-flex align-items-center gap-1">
                    <i class="bi bi-shield-lock-fill text-primary"></i> Pre-configured Demo Accounts:
                </div>
                <div class="d-flex flex-column gap-2 small">
                    <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('admin@acxiomcrm.local', 'Admin@12345!')">
                        <span><strong>Admin:</strong> admin@acxiomcrm.local</span>
                        <span class="badge bg-danger">Admin</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('manager@acxiomcrm.local', 'Manager@12345!')">
                        <span><strong>Manager:</strong> manager@acxiomcrm.local</span>
                        <span class="badge bg-warning text-dark">Manager</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('sales1@acxiomcrm.local', 'Sales@12345!')">
                        <span><strong>Sales Exec:</strong> sales1@acxiomcrm.local</span>
                        <span class="badge bg-primary">Sales</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, pwd) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pwd;
        }
    </script>
}

